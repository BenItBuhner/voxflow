# Copy to .env.local. Every variable is optional: without any of them the site builds and serves
# the landing, pricing and download pages, and /account explains that accounts are not switched on.

# Canonical origin, used for absolute URLs in metadata (Open Graph, canonical links).
NEXT_PUBLIC_SITE_URL=https://murmur.example

# GitHub repository whose Releases feed the download page, /api/releases/latest and
# /download/<platform>. Same variable the apps use for their updater; CI sets it to the
# repository that built the site. Defaults to BenItBuhner/Murmur.
MURMUR_UPDATE_REPO=BenItBuhner/Murmur

# Optional GitHub token (no scopes needed) to raise the Releases API rate limit from 60 to
# 5,000 requests an hour. The site asks GitHub at most once every ten minutes per page.
GITHUB_TOKEN=

# Accounts: the Clerk application shared with the desktop and Android apps, and the Convex
# deployment (packages/backend) that holds plans and usage. Both are needed for /account to
# offer sign-in; the publishable key and Convex URL are public by design.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CONVEX_URL=
