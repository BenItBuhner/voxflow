{
  "name": "murmur-monorepo",
  "version": "0.4.0",
  "description": "Murmur monorepo - Wispr Flow-style voice dictation for Windows, Linux, macOS (desktop) and Android.",
  "private": true,
  "license": "MIT",
  "scripts": {
    "desktop:install": "npm --prefix apps/desktop ci",
    "desktop:dev": "npm --prefix apps/desktop run dev",
    "desktop:test": "npm --prefix apps/desktop test",
    "desktop:lint": "npm --prefix apps/desktop run lint",
    "desktop:typecheck": "npm --prefix apps/desktop run typecheck",
    "desktop:build:win": "npm --prefix apps/desktop run build:win",
    "desktop:build:linux": "npm --prefix apps/desktop run build:linux",
    "desktop:build:mac": "npm --prefix apps/desktop run build:mac",
    "engine:install": "npm --prefix packages/text-engine ci",
    "engine:test": "npm --prefix packages/text-engine test",
    "engine:test:live": "npm --prefix packages/text-engine run test:live",
    "engine:golden": "npm --prefix packages/text-engine run golden",
    "backend:install": "npm --prefix packages/backend ci",
    "backend:test": "npm --prefix packages/backend test",
    "android:build": "cd apps/android && ./gradlew assembleDebug",
    "android:build:release": "cd apps/android && ./gradlew assembleRelease",
    "android:test": "cd apps/android && ./gradlew testDebugUnitTest",
    "web:install": "npm --prefix apps/web ci",
    "web:dev": "npm --prefix apps/web run dev",
    "web:typecheck": "npm --prefix apps/web run typecheck",
    "web:lint": "npm --prefix apps/web run lint",
    "web:test": "npm --prefix apps/web test",
    "web:build": "npm --prefix apps/web run build",
    "release": "node scripts/release.mjs",
    "release:check": "node scripts/release.mjs check",
    "release:aliases": "node scripts/release.mjs aliases",
    "test:release": "node --test scripts/release.test.mjs"
  }
}
